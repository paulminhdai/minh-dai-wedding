# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Configuration
ADMIN_PASSWORD=your_secure_admin_password

# JWT Configuration (for admin authentication)
# Generate a secure random string for production: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional Settings
ENABLE_GUEST_VALIDATION=true
NODE_ENV=development

# Home page mode toggle.
#   RSVP_OPEN=true   (default) — hero CTA shows "RSVP Now" / "Phúc Đáp Ngay"
#                                 and the RSVP form submit is enabled.
#   RSVP_OPEN=false             — hero CTA shows "Find Your Table" /
#                                 "Tìm Bàn Tiệc" linking to /yourtable,
#                                 and the RSVP form submit button is disabled.
# Use this once RSVPs are closed and you want to redirect arriving guests to
# the seating chart instead.
RSVP_OPEN=true

# Google Analytics Configuration (optional)
# Get your Measurement ID from https://analytics.google.com/
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Disposable Camera (guest photo upload) feature
# ============================================
#
# Storage: Supabase Storage (recommended)
# ----------------------------------------
# Reuses your existing Supabase project — no extra accounts, no extra bills.
# Free tier: 1 GB storage + 5 GB monthly egress.
#
# One-time setup (Supabase Dashboard):
#   1. Open your project -> Storage tab
#   2. Click "New bucket" -> name it `wedding-photos`
#   3. Toggle "Public bucket" ON  (required so the gallery can <img src> it)
#   4. (Optional) set file size limit to 10 MB and allowed MIME types to
#      image/jpeg, image/png, image/webp
#
# That's it - the server uses your existing SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY for auth. If the bucket doesn't exist, the
# server will try to create it on first upload.
#
# Optional - override the default bucket name:
# SUPABASE_STORAGE_BUCKET=wedding-photos


# Storage: Google Drive (legacy - NOT recommended)
# ------------------------------------------------
# Service accounts cannot own files in personal Gmail Drive (Google policy
# returns 403 storageQuotaExceeded). Only works in Google Workspace + Shared
# Drives, or via OAuth user delegation. Left here for completeness; leave
# blank to use Supabase Storage above.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Set to 1 to force-disable Supabase Storage and fall through to Drive / local.
# Useful only for testing the legacy adapters.
# SUPABASE_STORAGE_DISABLED=0

# Roll size per device. Like a real disposable camera.
PHOTOS_PER_ROLL=24

# Default Kodak film emulation for guest uploads. Each guest can override
# this on the camera page (the "LOAD YOUR FILM ROLL" picker); this value is
# the *initial* selection for first-time visitors and the fallback when a
# client doesn't send a `film` field.
#   off    — no colour grade (default).
#   gold   — Kodak Gold 200: warm, sunny, family-album classic.
#   portra — Kodak Portra 400: soft, low-contrast portrait/wedding film
#            (the photographer's go-to for weddings).
#   ektar  — Kodak Ektar 100: fine-grain, vivid, punchy outdoor look.
# Only NEW uploads pick up the active look; existing photos are unchanged.
# CAMERA_FILM=off

# Reveal date - photos are hidden from the public gallery until this point.
# ISO 8601 format with timezone. Default = midnight after the wedding (Pacific).
GALLERY_REVEAL_AT=2026-06-27T00:00:00-07:00
