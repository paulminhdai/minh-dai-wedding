# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Configuration
ADMIN_PASSWORD=your_secure_admin_password

# JWT Configuration (for admin authentication)
# Generate a secure random string for production: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Configuration (comma-separated list of allowed origins)
# In production, set this to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional Settings
ENABLE_GUEST_VALIDATION=true
NODE_ENV=development

# Google Analytics Configuration (optional)
# Get your Measurement ID from https://analytics.google.com/
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Disposable Camera (guest photo upload) feature
# ============================================
#
# Storage: Google Drive via service account
# 1. Create a Google Cloud project and enable the Drive API
# 2. Create a service account, download its JSON key
# 3. Encode the JSON key with:  base64 -i path/to/key.json | tr -d '\n'
#    and paste the single-line base64 result into GOOGLE_SERVICE_ACCOUNT_KEY below
# 4. Run:  npm run setup-drive
#    (this has the service account create + own a folder, sidestepping
#    Google's "sharing quota" error you get when sharing TO a service account)
# 5. Paste the folder id it prints into GOOGLE_DRIVE_FOLDER_ID below
#
# If these are blank, photos fall back to local disk (data/uploads/) — fine
# for development but NOT for production.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Roll size per device. Like a real disposable camera.
PHOTOS_PER_ROLL=24

# Reveal date - photos are hidden from the public gallery until this point.
# ISO 8601 format with timezone. Default = midnight after the wedding (Pacific).
GALLERY_REVEAL_AT=2026-06-27T00:00:00-07:00
